{
  "name": "fretline",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:e2e": "node test/e2e/smoke.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "midi-file": "1.2.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/three": "0.186.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "playwright": "1.56.1",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "vite": "8.1.6",
    "vitest": "5.0.3"
  }
}
